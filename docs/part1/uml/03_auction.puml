@startuml
!pragma layout smetana
left to right direction
skinparam dpi 130
skinparam shadowing false
skinparam defaultFontName Arial
actor "Участник" as Member
actor "Модератор" as Moderator
actor "Администратор" as Admin
Admin --|> Moderator
rectangle "ИС «Потеряшки»" {
  usecase "UC-05. Продать вещь\nна аукционе" as Auction
  usecase "UC-06. Изменить\nполномочия сотрудника" as Roles
  usecase "UC-07. Актуализировать\nинструкцию организации" as Directory
  usecase "UC-08. Изменить условия\nновых подписок" as Tariff
}
Member -- Auction
Moderator -- Auction
Member -- Roles
Admin -- Roles
Member -- Directory
Admin -- Directory
Member -- Tariff
Admin -- Tariff
note bottom of Auction
  Продавец и покупатели — разные участники.
  Допуск → лот → конкурирующие ставки →
  победитель → подтверждённая передача.
end note
@enduml
