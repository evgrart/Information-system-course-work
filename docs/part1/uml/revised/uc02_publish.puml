@startuml
!pragma layout smetana
top to bottom direction
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor white
skinparam ArrowColor black
actor "Участник\nнашедший" as Finder
actor "Модератор" as Moderator
rectangle "ИС «Потеряшки»" {
  usecase "UC-02. Опубликовать\nнаходку" as Publish
  usecase "Подготовить карточку\nс местом и временем" as Draft
  usecase "Добавить фотографию" as Photo
  usecase "Проверить объявление" as Review
  usecase "Открыть карточку\nв каталоге" as Catalog
}
Finder -- Publish
Moderator -- Review
Publish ..> Draft : <<include>>
Publish ..> Review : <<include>>
Publish ..> Catalog : <<include>>
Photo ..> Draft : <<extend>>\n[автор прикладывает снимок]
Draft -[hidden]down- Photo
Photo -[hidden]down- Review
Review -[hidden]down- Catalog
@enduml
