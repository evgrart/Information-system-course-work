@startuml
!pragma layout smetana
top to bottom direction
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor white
skinparam ArrowColor black
actor "Участник" as Member
actor "Модератор" as Moderator
rectangle "ИС «Потеряшки»" {
  usecase "UC-01. Получить доступ\nк сервису" as Access
  usecase "Создать учётную запись" as Register
  usecase "Подтвердить почту" as Confirm
  usecase "Рассмотреть профиль" as Review
  usecase "Активировать подписку\nчерез учебную оплату" as Subscribe
}
Member -- Access
Moderator -- Review
Access ..> Register : <<include>>
Access ..> Confirm : <<include>>
Access ..> Review : <<include>>
Access ..> Subscribe : <<include>>
Register -[hidden]down- Confirm
Confirm -[hidden]down- Review
Review -[hidden]down- Subscribe
@enduml
