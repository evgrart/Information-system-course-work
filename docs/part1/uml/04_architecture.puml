@startuml
!pragma layout smetana
top to bottom direction
skinparam dpi 130
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam shadowing false
component "Браузер\nHTML и формы" as Browser
node "Spring Boot · одна JVM · Java 17" {
  component "Spring Security / WebSessions\nJWT, CSRF, проверенный сеанс" as Security
  component "Spring MVC / Thymeleaf\nконтроллеры, формы, модели страниц" as MVC
  component "Предметные сервисы / AccessPolicy\nаккаунты, объявления, возврат, торги,\nмодерация, подписки, события" as Services
  component "WebJobs\nзакрытие торгов, Outbox" as Jobs
  component "Уровень хранения\nJPA / SqlStore / DatabaseFunctions\nпараметризованные запросы" as Storage
  component "Адаптеры\nPrivateFiles / почта / учебная оплата" as Adapters
}
database "PostgreSQL\nограничения, триггеры, PL/pgSQL" as DB
folder "Закрытые вложения\nSTORAGE_ROOT" as Files
cloud "Почтовая служба\nпри настройке SMTP" as Mail
Browser --> Security : HTTP-запрос
Security --> MVC : WebIdentity
MVC --> Services : команда пользователя
Jobs --> Services : фоновая операция
Services --> Storage : транзакция
MVC --> Storage : WebQueries / чтение
Services --> Adapters : проверка и доставка
Storage --> DB : JDBC / функции
Adapters --> Files : запись и разрешённая выдача
Adapters ..> Mail : SMTP / STARTTLS
note bottom of DB
  Критичные переходы выполняются в БД.
  Java вызывает функции, а не заменяет их.
end note
@enduml
